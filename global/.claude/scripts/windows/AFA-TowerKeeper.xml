<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows scheduled task for a machine that only keeps the fleet running (the tower): every 15 minutes and at sign-in it runs
  openclaw_status_refresh.sh, which on any machine other than NX-01 does the keeper steps only.
  No password is stored: LogonType InteractiveToken runs only while the user is signed in. Automatic sign-in stays off.
  The checked-in file has no UserId. A LogonTrigger without one fires for any user's sign-in, and Windows then refuses to register
  the task without administrator rights ("Access is denied"), so the install script fills the signed-in user (from whoami.exe)
  into the LogonTrigger first.

  Install (from WSL, as the signed-in user; nothing to type but this):
    ~/.claude/scripts/windows/install-tower-keeper.sh          (give it the argument print to see the filled-in XML and register nothing)
  Check that no password is stored:  schtasks.exe /query /tn '\AFA\TowerKeeper' /xml
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\AFA\TowerKeeper</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
  </Settings>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
    <TimeTrigger>
      <StartBoundary>2026-10-28T00:00:00</StartBoundary>
      <Repetition>
        <Interval>PT15M</Interval>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>conhost.exe</Command>
      <Arguments>--headless wsl.exe -d Debian -- bash -lc "~/.claude/scripts/openclaw_status_refresh.sh &gt;&gt;~/.claude/state/status-refresh.log 2&gt;&amp;1"</Arguments>
    </Exec>
  </Actions>
</Task>
